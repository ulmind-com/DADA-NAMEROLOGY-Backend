# Copy to .env and fill in. NEVER commit .env - it holds live credentials.
ENV=development
DEBUG=true

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-me

# --- Database: MongoDB Atlas ------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=dada_numerology
MONGO_TIMEOUT_MS=8000

# --- Email OTP -------------------------------------------------------------
# Leave SMTP_HOST empty in development: the OTP is returned in the API response
# (and shown as a toast in the app) instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DADA'S NUMEROLOGY <no-reply@dadanumerology.com>
SMTP_TLS=true
OTP_DEV_ECHO=true          # MUST be false in production

# --- Google sign-in --------------------------------------------------------
# Comma separated: web, iOS and Android OAuth client ids.
# The same ids go in mobile/app.json -> extra.googleClientIds
GOOGLE_CLIENT_IDS_RAW=

# --- Cloudinary (profile photos + archived PDF reports) --------------------
# Leave blank to run without uploads: avatars stay unset and shared report links
# are served straight from this API instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_API_KEY=
CLOUDINARY_CLOUD_SECRET=
CLOUDINARY_FOLDER=dada-numerology

# --- CORS ------------------------------------------------------------------
# "*" in development; narrow to the admin panel's domain in production.
CORS_ORIGINS_RAW=*

# --- Seeded super-admin (change before deploying) --------------------------
ADMIN_EMAIL=admin@dadanumerology.com
ADMIN_PASSWORD=change-me

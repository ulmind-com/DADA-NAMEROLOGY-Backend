# Copy to .env and fill in. NEVER commit .env - it holds live credentials.
ENV=development
DEBUG=true

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-me

# --- Database: MongoDB Atlas ------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=dada_numerology
MONGO_TIMEOUT_MS=8000

# --- Email OTP -------------------------------------------------------------
# Resend is the primary transport: it is an HTTPS API, so it works on hosts that
# block outbound SMTP ports. The from-address must be on a domain verified in
# the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM=DADA'S NUMEROLOGY <noreply@yourdomain.com>

# SMTP fallback, used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DADA'S NUMEROLOGY <noreply@yourdomain.com>
SMTP_TLS=true

# With no transport configured the OTP is returned in the API response instead
# of being emailed. MUST be false in production - with it off and delivery
# failing, signup returns 503 rather than stranding the user on the OTP screen.
OTP_DEV_ECHO=true

# --- Google sign-in --------------------------------------------------------
# Comma separated: web, iOS and Android OAuth client ids.
# The same ids go in mobile/app.json -> extra.googleClientIds
GOOGLE_CLIENT_IDS_RAW=

# --- Cloudinary (profile photos + archived PDF reports) --------------------
# Leave blank to run without uploads: avatars stay unset and shared report links
# are served straight from this API instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_API_KEY=
CLOUDINARY_CLOUD_SECRET=
CLOUDINARY_FOLDER=dada-numerology

# --- CORS ------------------------------------------------------------------
# "*" is fine while auth is bearer-token only: a hostile page can send a request
# but cannot attach someone else's token, and there are no cookies to ride.
# Narrow to the admin panel's exact origin if you ever move to cookie sessions.
CORS_ORIGINS_RAW=*
# Optional pattern for origins that change per deploy, such as Vercel previews:
#   ^https://your-admin(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- Seeded super-admin (change before deploying) --------------------------
ADMIN_EMAIL=admin@dadanumerology.com
ADMIN_PASSWORD=change-me
